@prefix ex: <https://example.org/demo/> .
@prefix ir: <https://example.org/incident#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

schema:Action a rdfs:Class ;
    rdfs:label "Action" ;
    rdfs:subClassOf schema:Thing .

schema:ActionStatusType a rdfs:Class ;
    rdfs:label "ActionStatusType" ;
    rdfs:subClassOf schema:StatusEnumeration .

schema:Enumeration a rdfs:Class ;
    rdfs:label "Enumeration" ;
    rdfs:subClassOf schema:Intangible .

schema:Intangible a rdfs:Class ;
    rdfs:label "Intangible" ;
    rdfs:subClassOf schema:Thing .

schema:Organization a rdfs:Class ;
    rdfs:label "Organization" ;
    rdfs:subClassOf schema:Thing .

schema:OrganizationRole a rdfs:Class ;
    rdfs:label "OrganizationRole" ;
    rdfs:subClassOf schema:Role .

schema:Person a rdfs:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf schema:Thing .

schema:Product a rdfs:Class ;
    rdfs:label "Product" ;
    rdfs:subClassOf schema:Thing .

schema:Role a rdfs:Class ;
    rdfs:label "Role" ;
    rdfs:subClassOf schema:Intangible .

schema:Service a rdfs:Class ;
    rdfs:label "Service" ;
    rdfs:subClassOf schema:Intangible .

schema:StatusEnumeration a rdfs:Class ;
    rdfs:label "StatusEnumeration" ;
    rdfs:subClassOf schema:Enumeration .

schema:Thing a rdfs:Class ;
    rdfs:label "Thing" .

prov:wasAttributedTo a owl:ObjectProperty ;
    rdfs:label "wasAttributedTo" ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Agent ;
    rdfs:subPropertyOf prov:wasInfluencedBy .

ex:CEOAssignment a ir:IncidentAssignment ;
    ir:assignedActor ex:Jordan ;
    ir:assignedRole ex:CEO ;
    ir:forIncident ex:INC001 ;
    schema:member ex:Jordan ;
    schema:roleName "CEO" .

ex:CommsAssignment a ir:IncidentAssignment ;
    ir:assignedActor ex:Robin ;
    ir:assignedRole ex:Communications ;
    ir:forIncident ex:INC001 ;
    schema:member ex:Robin ;
    schema:roleName "Communications lead" .

ex:IsolationGrant a ir:Approval ;
    ir:approvedBy ex:CISOAssignment ;
    ir:decision "Granted" ;
    ir:forAction ex:IsolateLaptop ;
    ir:recordedAt "2026-10-27T06:05:00+00:00"^^xsd:dateTime .

ex:LegalAssignment a ir:IncidentAssignment ;
    ir:assignedActor ex:Lee ;
    ir:assignedRole ex:Legal ;
    ir:forIncident ex:INC001 ;
    schema:member ex:Lee ;
    schema:roleName "Legal counsel" .

ex:OwnerAssignment a ir:IncidentAssignment ;
    ir:assignedActor ex:Sam ;
    ir:assignedRole ex:BusinessOwner ;
    ir:forIncident ex:INC001 ;
    schema:member ex:Sam ;
    schema:roleName "Payroll owner" .

ex:PausePayroll a ir:ServicePauseAction ;
    rdfs:label "Pause Payroll" ;
    ir:executor ex:ITAssignment ;
    ir:forIncident ex:INC001 ;
    ir:governedBy ex:PayrollPausePolicy ;
    ir:proposedBy ex:CommandAssignment ;
    ir:target ex:Payroll ;
    schema:actionStatus schema:PotentialActionStatus ;
    schema:agent ex:Eli ;
    schema:name "Pause Payroll" .

ex:PossibleExfiltration a ir:Finding ;
    prov:wasAttributedTo ex:Dana ;
    ir:assertedBy ex:SOCAssignment ;
    ir:findingStatus "Suspected" ;
    ir:forIncident ex:INC001 ;
    ir:statement "Possible data exfiltration from Laptop-42" ;
    ir:supportedBy ex:EDRAlert .

ex:UserReport a ir:Evidence ;
    rdfs:label "User reported opening a suspicious attachment" ;
    prov:wasAttributedTo ex:Alex ;
    ir:collectedBy ex:UserAssignment ;
    ir:forIncident ex:INC001 ;
    ir:observedAt "2026-10-27T06:00:00+00:00"^^xsd:dateTime ;
    ir:sourceId "synthetic-helpdesk-001" ;
    schema:name "User reported opening a suspicious attachment" .

ir:IncidentOntology a owl:Ontology ;
    rdfs:label "Security incident learning example" ;
    rdfs:comment "Fictional organizational policies, not a security standard." .

ir:affectsAsset a owl:ObjectProperty ;
    rdfs:label "affects asset" ;
    rdfs:domain ir:SecurityIncident ;
    rdfs:range ir:Asset .

ir:approvedBy a owl:ObjectProperty ;
    rdfs:label "decision made by assignment" ;
    rdfs:domain ir:Approval ;
    rdfs:range ir:IncidentAssignment .

ir:assertedBy a owl:ObjectProperty ;
    rdfs:label "asserted by assignment" ;
    rdfs:domain ir:Finding ;
    rdfs:range ir:IncidentAssignment .

ir:assignedActor a owl:ObjectProperty ;
    rdfs:label "assigned actor" ;
    rdfs:domain ir:IncidentAssignment ;
    rdfs:range ir:Actor .

ir:assignedRole a owl:ObjectProperty ;
    rdfs:label "assigned role" ;
    rdfs:domain ir:IncidentAssignment ;
    rdfs:range ir:Role .

ir:collectedBy a owl:ObjectProperty ;
    rdfs:label "collected by assignment" ;
    rdfs:domain ir:Evidence ;
    rdfs:range ir:IncidentAssignment .

ir:decision a owl:DatatypeProperty ;
    rdfs:label "decision" ;
    rdfs:domain ir:Approval ;
    rdfs:range xsd:string .

ir:detectedAt a owl:DatatypeProperty ;
    rdfs:label "detected at" ;
    rdfs:domain ir:SecurityIncident ;
    rdfs:range xsd:dateTime .

ir:executor a owl:ObjectProperty ;
    rdfs:label "designated executor assignment" ;
    rdfs:domain ir:ResponseAction ;
    rdfs:range ir:IncidentAssignment .

ir:findingStatus a owl:DatatypeProperty ;
    rdfs:label "finding status" ;
    rdfs:domain ir:Finding ;
    rdfs:range xsd:string .

ir:forAction a owl:ObjectProperty ;
    rdfs:label "decision about action" ;
    rdfs:domain ir:Approval ;
    rdfs:range ir:ResponseAction .

ir:forIncident a owl:ObjectProperty ;
    rdfs:label "in incident" ;
    rdfs:range ir:SecurityIncident .

ir:governedBy a owl:ObjectProperty ;
    rdfs:label "governed by policy" ;
    rdfs:domain ir:ResponseAction ;
    rdfs:range ir:AuthorizationPolicy .

ir:memberOf a owl:ObjectProperty ;
    rdfs:label "member of" ;
    rdfs:domain schema:Person ;
    rdfs:range schema:Organization .

ir:observedAt a owl:DatatypeProperty ;
    rdfs:label "observed at" ;
    rdfs:domain ir:Evidence ;
    rdfs:range xsd:dateTime .

ir:proposedBy a owl:ObjectProperty ;
    rdfs:label "proposed by assignment" ;
    rdfs:domain ir:ResponseAction ;
    rdfs:range ir:IncidentAssignment .

ir:recordedAt a owl:DatatypeProperty ;
    rdfs:label "decision recorded at" ;
    rdfs:domain ir:Approval ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf prov:generatedAtTime .

ir:requiredApproverRole a owl:ObjectProperty ;
    rdfs:label "requires decision from role" ;
    rdfs:domain ir:AuthorizationPolicy ;
    rdfs:range ir:Role .

ir:requiredExecutorRole a owl:ObjectProperty ;
    rdfs:label "requires executor role" ;
    rdfs:domain ir:AuthorizationPolicy ;
    rdfs:range ir:Role .

ir:severity a owl:DatatypeProperty ;
    rdfs:label "severity" ;
    rdfs:domain ir:SecurityIncident ;
    rdfs:range xsd:string .

ir:sourceId a owl:DatatypeProperty ;
    rdfs:label "evidence source identifier" ;
    rdfs:domain ir:Evidence ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf schema:identifier .

ir:statement a owl:DatatypeProperty ;
    rdfs:label "finding statement" ;
    rdfs:domain ir:Finding ;
    rdfs:range xsd:string .

ir:status a owl:DatatypeProperty ;
    rdfs:label "incident status" ;
    rdfs:domain ir:SecurityIncident ;
    rdfs:range xsd:string .

ir:supportedBy a owl:ObjectProperty ;
    rdfs:label "supported by evidence" ;
    rdfs:domain ir:Finding ;
    rdfs:range ir:Evidence ;
    rdfs:subPropertyOf prov:wasDerivedFrom .

ir:target a owl:ObjectProperty ;
    rdfs:label "action target" ;
    rdfs:domain ir:ResponseAction ;
    rdfs:subPropertyOf schema:object .

ir:threatensService a owl:ObjectProperty ;
    rdfs:label "puts service at risk" ;
    rdfs:domain ir:SecurityIncident ;
    rdfs:range ir:BusinessService .

ir:usedBy a owl:ObjectProperty ;
    rdfs:label "used by" ;
    rdfs:domain ir:Asset ;
    rdfs:range schema:Person .

ir:usedFor a owl:ObjectProperty ;
    rdfs:label "used to access service" ;
    rdfs:domain ir:Asset ;
    rdfs:range ir:BusinessService .

schema:actionStatus a rdf:Property ;
    rdfs:label "actionStatus" .

schema:agent a rdf:Property ;
    rdfs:label "agent" .

schema:member a rdf:Property ;
    rdfs:label "member" .

schema:name a rdf:Property ;
    rdfs:label "name" ;
    rdfs:subPropertyOf rdfs:label .

schema:roleName a rdf:Property ;
    rdfs:label "roleName" .

prov:Agent a owl:Class ;
    rdfs:label "Agent" .

prov:generatedAtTime a owl:DatatypeProperty ;
    rdfs:label "generatedAtTime" ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:dateTime .

prov:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:label "wasDerivedFrom" ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Entity ;
    rdfs:subPropertyOf prov:wasInfluencedBy .

ex:BusinessOwner a ir:Role ;
    rdfs:label "Payroll owner" ;
    rdfs:comment "Explains service impact and helps validate recovery." ;
    schema:name "Payroll owner" .

ex:CISOAssignment a ir:IncidentAssignment ;
    ir:assignedActor ex:Morgan ;
    ir:assignedRole ex:CISO ;
    ir:forIncident ex:INC001 ;
    schema:member ex:Morgan ;
    schema:roleName "CISO" .

ex:CommandAssignment a ir:IncidentAssignment ;
    ir:assignedActor ex:Taylor ;
    ir:assignedRole ex:IncidentCommander ;
    ir:forIncident ex:INC001 ;
    schema:member ex:Taylor ;
    schema:roleName "Incident commander" .

ex:Communications a ir:Role ;
    rdfs:label "Communications lead" ;
    rdfs:comment "Prepares audience-appropriate updates from approved findings." ;
    schema:name "Communications lead" .

ex:EDRAlert a ir:Evidence ;
    rdfs:label "EDR reported unusual outbound traffic" ;
    prov:wasAttributedTo ex:Dana ;
    ir:collectedBy ex:SOCAssignment ;
    ir:forIncident ex:INC001 ;
    ir:observedAt "2026-10-27T06:02:00+00:00"^^xsd:dateTime ;
    ir:sourceId "synthetic-edr-007" ;
    schema:name "EDR reported unusual outbound traffic" .

ex:EndUser a ir:Role ;
    rdfs:label "End user" ;
    rdfs:comment "Reports symptoms and follows response instructions." ;
    schema:name "End user" .

ex:IT a schema:Organization ;
    rdfs:label "IT operations" ;
    schema:member ex:ITAssignment ;
    schema:name "IT operations" .

ex:IncidentCommander a ir:Role ;
    rdfs:label "Incident commander" ;
    rdfs:comment "Coordinates the incident, tasks and updates." ;
    schema:name "Incident commander" .

ex:IsolateLaptop a ir:EndpointIsolationAction ;
    rdfs:label "Isolate Laptop-42" ;
    ir:executor ex:ITAssignment ;
    ir:forIncident ex:INC001 ;
    ir:governedBy ex:IsolationPolicy ;
    ir:proposedBy ex:SOCAssignment ;
    ir:target ex:Laptop42 ;
    schema:actionStatus schema:PotentialActionStatus ;
    schema:agent ex:Eli ;
    schema:name "Isolate Laptop-42" .

ex:IsolationPolicy a ir:AuthorizationPolicy ;
    rdfs:label "Example endpoint isolation policy" ;
    ir:requiredApproverRole ex:CISO ;
    ir:requiredExecutorRole ex:ITResponder ;
    schema:name "Example endpoint isolation policy" .

ex:Legal a ir:Role ;
    rdfs:label "Legal counsel" ;
    rdfs:comment "Assesses legal obligations and notification requirements." ;
    schema:name "Legal counsel" .

ex:PayrollPausePolicy a ir:AuthorizationPolicy ;
    rdfs:label "Example major service interruption policy" ;
    ir:requiredApproverRole ex:CEO ;
    ir:requiredExecutorRole ex:ITResponder ;
    schema:name "Example major service interruption policy" .

ex:SOC a schema:Organization ;
    rdfs:label "Security Operations Center" ;
    schema:member ex:SOCAssignment ;
    schema:name "Security Operations Center" .

ex:SOCAnalyst a ir:Role ;
    rdfs:label "SOC analyst" ;
    rdfs:comment "Triages alerts, preserves evidence, proposes containment." ;
    schema:name "SOC analyst" .

ex:UserAssignment a ir:IncidentAssignment ;
    ir:assignedActor ex:Alex ;
    ir:assignedRole ex:EndUser ;
    ir:forIncident ex:INC001 ;
    schema:member ex:Alex ;
    schema:roleName "End user" .

ir:Actor a owl:Class ;
    rdfs:label "Actor" .

ir:EndpointIsolationAction a owl:Class ;
    rdfs:label "Endpoint isolation" ;
    rdfs:subClassOf ir:ContainmentAction .

ir:ServicePauseAction a owl:Class ;
    rdfs:label "Business service pause" ;
    rdfs:subClassOf ir:ContainmentAction .

ir:Workstation a owl:Class ;
    rdfs:label "Workstation" ;
    rdfs:subClassOf ir:Asset,
        schema:Product .

schema:identifier a rdf:Property ;
    rdfs:label "identifier" .

schema:object a rdf:Property ;
    rdfs:label "object" .

prov:wasInfluencedBy a owl:ObjectProperty ;
    rdfs:label "wasInfluencedBy" .

ex:CEO a ir:Role ;
    rdfs:label "CEO" ;
    rdfs:comment "Makes major business tradeoffs within organizational policy." ;
    schema:name "CEO" .

ex:CISO a ir:Role ;
    rdfs:label "CISO" ;
    rdfs:comment "Makes security-risk decisions within organizational policy." ;
    schema:name "CISO" .

ex:Jordan a schema:Person ;
    rdfs:label "Jordan" ;
    schema:name "Jordan" .

ex:Laptop42 a ir:Workstation ;
    rdfs:label "Laptop-42" ;
    ir:usedBy ex:Alex ;
    ir:usedFor ex:Payroll ;
    schema:name "Laptop-42" .

ex:Lee a schema:Person ;
    rdfs:label "Lee" ;
    schema:name "Lee" .

ex:Morgan a schema:Person ;
    rdfs:label "Morgan" ;
    schema:name "Morgan" .

ex:Robin a schema:Person ;
    rdfs:label "Robin" ;
    schema:name "Robin" .

ex:Sam a schema:Person ;
    rdfs:label "Sam" ;
    schema:name "Sam" .

ex:Taylor a schema:Person ;
    rdfs:label "Taylor" ;
    schema:name "Taylor" .

ir:ContainmentAction a owl:Class ;
    rdfs:label "Containment action" ;
    rdfs:subClassOf ir:ResponseAction .

schema:PotentialActionStatus a schema:ActionStatusType ;
    rdfs:label "PotentialActionStatus" .

ex:ITAssignment a ir:IncidentAssignment ;
    ir:assignedActor ex:Eli ;
    ir:assignedRole ex:ITResponder ;
    ir:forIncident ex:INC001 ;
    schema:member ex:Eli ;
    schema:roleName "IT responder" .

ex:ITResponder a ir:Role ;
    rdfs:label "IT responder" ;
    rdfs:comment "Implements containment and recovery through authorized tools." ;
    schema:name "IT responder" .

ex:Payroll a ir:BusinessService ;
    rdfs:label "Payroll" ;
    schema:name "Payroll" .

ir:BusinessService a owl:Class ;
    rdfs:label "Business service" ;
    rdfs:subClassOf schema:Service .

ex:Alex a schema:Person ;
    rdfs:label "Alex" ;
    schema:name "Alex" .

ex:Dana a schema:Person ;
    rdfs:label "Dana" ;
    ir:memberOf ex:SOC ;
    schema:name "Dana" .

ex:Eli a schema:Person ;
    rdfs:label "Eli" ;
    ir:memberOf ex:IT ;
    schema:name "Eli" .

ex:SOCAssignment a ir:IncidentAssignment ;
    ir:assignedActor ex:Dana ;
    ir:assignedRole ex:SOCAnalyst ;
    ir:forIncident ex:INC001 ;
    schema:member ex:Dana ;
    schema:roleName "SOC analyst" .

ir:Asset a owl:Class ;
    rdfs:label "IT asset" .

ir:Approval a owl:Class ;
    rdfs:label "Recorded decision about one action" ;
    rdfs:subClassOf prov:Entity .

ir:AuthorizationPolicy a owl:Class ;
    rdfs:label "Example approval policy" .

ir:Finding a owl:Class ;
    rdfs:label "Finding or hypothesis" ;
    rdfs:subClassOf prov:Entity .

ir:Evidence a owl:Class ;
    rdfs:label "Evidence record" ;
    rdfs:subClassOf prov:Entity .

ir:ResponseAction a owl:Class ;
    rdfs:label "Proposed response action" ;
    rdfs:subClassOf schema:Action .

prov:Entity a owl:Class ;
    rdfs:label "Entity" .

ir:SecurityIncident a owl:Class ;
    rdfs:label "Security incident" .

ir:Role a owl:Class ;
    rdfs:label "Incident role" .

ex:INC001 a ir:SecurityIncident ;
    rdfs:label "INC-001: suspicious payroll workstation" ;
    ir:affectsAsset ex:Laptop42 ;
    ir:detectedAt "2026-10-27T06:00:00+00:00"^^xsd:dateTime ;
    ir:severity "High" ;
    ir:status "Investigating" ;
    ir:threatensService ex:Payroll ;
    schema:name "INC-001: suspicious payroll workstation" .

ir:IncidentAssignment a owl:Class ;
    rdfs:label "Actor assigned a role in one incident" ;
    rdfs:subClassOf schema:OrganizationRole .

